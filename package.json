{
	"name": "MIFE",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.3",
			"varlock": "1.23.0",
			"better-auth": "1.7.12",
			"evlog": "^2.33.1",
			"drizzle-orm": "1.0.0-rc.5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "nx run-many -t dev",
		"build": "nx run-many -t build",
		"check-types": "nx run-many -t check-types",
		"dev:web": "nx run-many -t dev --projects=web",
		"dev:server": "nx run-many -t dev --projects=server",
		"db:push": "nx run-many -t db:push --projects=@SyMi/db",
		"db:studio": "nx run-many -t db:studio --projects=@SyMi/db",
		"db:generate": "nx run-many -t db:generate --projects=@SyMi/db",
		"db:migrate": "nx run-many -t db:migrate --projects=@SyMi/db",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@SyMi/config": "workspace:*",
		"@biomejs/biome": "^2.6.2",
		"@types/bun": "catalog:",
		"lefthook": "^2.2.1",
		"nx": "^24.0.1",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.3"
}
