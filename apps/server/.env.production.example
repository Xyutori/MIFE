# Contoh apps/server/.env.production — salin ke .env.production lalu isi secret.
# JANGAN commit file .env.production (gitignored).
BETTER_AUTH_SECRET=isi-min-32-karakter
BETTER_AUTH_URL=https://mife.feryn.xyz
CORS_ORIGIN=https://mife.feryn.xyz
# HOST=postgres untuk deploy docker, HOST=localhost tidak berlaku di sini.
# Password HARUS sama dengan POSTGRES_PASSWORD service postgres di compose.
DATABASE_URL=postgresql://app:mife-local-only@postgres:5432/symi
PORT=4000
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_COOKIE_DOMAIN=
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
# HARUS sama dengan MINIO_ROOT_PASSWORD service minio di compose.
S3_SECRET_KEY=mife-minio-local
S3_BUCKET=xymi-images
# --- Infra bundled (dibaca service postgres/minio via env_file yang sama) ---
# Password HARUS sama dengan password di DATABASE_URL di atas.
POSTGRES_USER=app
POSTGRES_PASSWORD=mife-local-only
POSTGRES_DB=symi
# HARUS sama dengan S3_ACCESS_KEY / S3_SECRET_KEY di atas.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=mife-minio-local
# Token tunnel lama (tak dipakai; tunnel lokal via ~/.cloudflared).
CLOUDFLARE_TUNNEL_TOKEN=
