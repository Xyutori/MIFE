{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
	},
	"dependencies": {
		"@SyMi/auth": "workspace:*",
		"@SyMi/db": "workspace:*",
		"@aws-sdk/client-s3": "^3.1146.0",
		"@elysiajs/cors": "^1.4.2",
		"@sinclair/typebox": "^0.34.52",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"elysia": "^1.4.30",
		"evlog": "catalog:",
		"fflate": "^0.8.3",
		"node-html-parser": "^9.0.6",
		"sharp": "^0.35.5",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@SyMi/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
