# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Bukan secret (port tidak pernah disensor redaction karena number);
# tandai non-sensitif agar varlock tak menganggapnya bocor.
# @sensitive=false @type=port
PORT=

# @type=string(minLength=1)
DATABASE_URL=

# Email bootstrap adalah identifier, bukan secret: nilainya wajar muncul di
# respons profile (seperti client_id muncul di URL authorize), jadi
# dikecualikan dari leak-prevention agar Varlock tidak menandai respons
# berisi email ini sebagai kebocoran.
# @optional @sensitive={preventLeaks=false} @type=string
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# OAuth client_id sah muncul di URL authorize provider (publik by design),
# jadi dikecualikan dari leak-prevention (secret tetap diproteksi).
# @optional @sensitive={preventLeaks=false} @type=string
GOOGLE_CLIENT_ID=

# @optional @type=string
GOOGLE_CLIENT_SECRET=

# @optional @sensitive={preventLeaks=false} @type=string
GITHUB_CLIENT_ID=

# @optional @type=string
GITHUB_CLIENT_SECRET=

# @optional @type=string
BETTER_AUTH_TRUSTED_ORIGINS=

# @optional @type=string
BETTER_AUTH_COOKIE_DOMAIN=

# @type=url
S3_ENDPOINT=

# Identifier infrastruktur, bukan secret; nilainya pendek sehingga
# berbahaya bila disensor (redaksi substring pendek merusak teks biasa).
# @sensitive=false @type=string(minLength=1)
S3_REGION=

# Key ID publik (bukan S3_SECRET_KEY); pendek → non-sensitif.
# @sensitive=false @type=string(minLength=1)
S3_ACCESS_KEY=

# @type=string(minLength=1)
S3_SECRET_KEY=

# Nama bucket adalah identifier, bukan secret.
# @sensitive=false @type=string(minLength=1)
S3_BUCKET=
