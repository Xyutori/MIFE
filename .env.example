# Salin ke `.env` (gitignored) lalu isi nilai rahasianya.
# Dipakai HANYA untuk interpolasi docker compose (password DB/MinIO, token tunnel).

# Password Postgres bundled (hanya dipakai saat inisialisasi volume pertama).
# HARUS sama dengan password di DATABASE_URL di bawah.
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# SATU-SATUNYA konfigurasi database untuk aplikasi. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DB
# - Deploy docker: HOST=postgres (nama service compose)
# - Dev lokal: HOST=localhost
DATABASE_URL=postgresql://app:ganti-dengan-password-kuat@postgres:5432/symi

# Kredensial MinIO service `minio`. SAMAKAN dengan S3_ACCESS_KEY /
# S3_SECRET_KEY di apps/server/.env agar server dev & prod memakai kredensial sama.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=EDQ_-07Pu1bg6kAaU5EGRQX-aYzyL_O0

# Token tunnel Cloudflare (dash.cloudflare.com → Zero Trust → Networks → Tunnels).
# Hostname mife.feryn.xyz di tunnel tersebut harus mengarah ke http://web:80.
CLOUDFLARE_TUNNEL_TOKEN=
